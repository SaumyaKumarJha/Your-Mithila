generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id              String          @id @default(cuid())
  name            String
  email           String          @unique
  password        String?
  phone           String?         @unique
  role            Role            @default(SEEKER)
  city            String          @default("Madhubani")
  district        String          @default("Madhubani")
  state           String          @default("Bihar")
  whatsapp        String?
  interests       String[]
  isActive        Boolean         @default(true)
  isVerified      Boolean         @default(false)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  properties      Property[]
  jobs            Job[]
  subscription    Subscription?
  savedProperties SavedProperty[]
  accounts        Account[]
  sessions        Session[]
  reviews         Review[]
  searchAlerts    SearchAlert[]
  notifications   Notification[]
}

enum Role {
  SEEKER
  OWNER
  ADMIN
}

model Property {
  id              String        @id @default(cuid())
  title           String
  description     String
  type            PropertyType
  purpose         Purpose
  price           Float
  priceUnit       PriceUnit
  area            Float?
  bedrooms        Int?
  bathrooms       Int?
  floor           Int?
  totalFloors     Int?
  address         String
  locality        String
  city            String        @default("Madhubani")
  district        String        @default("Madhubani")
  state           String        @default("Bihar")
  pincode         String?
  latitude        Float?
  longitude       Float?
  images          String[]
  amenities       String[]
  contactName     String
  contactPhone    String
  contactWhatsapp String?
  isVerified      Boolean       @default(false)
  isAvailable     Boolean       @default(true)
  isFeatured      Boolean       @default(false)
  viewCount       Int           @default(0)
  whatsappClicks  Int           @default(0)
  enquiryCount    Int           @default(0)
  expiresAt       DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  owner           User          @relation(fields: [ownerId], references: [id])
  ownerId         String
  savedBy         SavedProperty[]
  enquiries       Enquiry[]
}

enum PropertyType {
  FLAT
  ROOM
  HOUSE
  SHOP
  LAND
  WAREHOUSE
  OFFICE
  VACANT_SPACE
}

enum Purpose {
  RENT
  SALE
}

enum PriceUnit {
  MONTHLY
  YEARLY
  TOTAL
}

model Job {
  id              String     @id @default(cuid())
  title           String
  description     String
  organization    String
  orgType         OrgType
  jobType         JobType
  salaryMin       Float?
  salaryMax       Float?
  salaryUnit      SalaryUnit @default(MONTHLY)
  address         String
  locality        String
  city            String     @default("Madhubani")
  contactName     String
  contactPhone    String
  contactWhatsapp String?
  requirements    String?
  benefits        String?
  latitude        Float?
  longitude       Float?
  isVerified      Boolean    @default(false)
  isActive        Boolean    @default(true)
  isFeatured      Boolean    @default(false)
  viewCount       Int        @default(0)
  whatsappClicks  Int        @default(0)
  expiresAt       DateTime?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  postedBy        User       @relation(fields: [postedById], references: [id])
  postedById      String
  enquiries       Enquiry[]
}

enum OrgType {
  HOTEL
  HOSPITAL
  SCHOOL
  SHOP
  FACTORY
  OFFICE
  HOME
  OTHER
}

enum JobType {
  FULL_TIME
  PART_TIME
  CONTRACT
  DAILY_WAGE
}

enum SalaryUnit {
  DAILY
  MONTHLY
  YEARLY
}

model Subscription {
  id         String    @id @default(cuid())
  plan       PlanType
  status     SubStatus @default(ACTIVE)
  startDate  DateTime  @default(now())
  endDate    DateTime
  price      Float
  razorpayId String?
  user       User      @relation(fields: [userId], references: [id])
  userId     String    @unique
  createdAt  DateTime  @default(now())
}

enum PlanType {
  BASIC
  STANDARD
  PRO
  YEARLY_STANDARD
}

enum SubStatus {
  ACTIVE
  EXPIRED
  CANCELLED
}

model SavedProperty {
  id         String   @id @default(cuid())
  user       User     @relation(fields: [userId], references: [id])
  userId     String
  property   Property @relation(fields: [propertyId], references: [id])
  propertyId String
  createdAt  DateTime @default(now())

  @@unique([userId, propertyId])
}

model OtpVerification {
  id        String   @id @default(cuid())
  email     String
  phone     String?
  otp       String
  expiresAt DateTime
  verified  Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([email])
}

model Complaint {
  id        String   @id @default(cuid())
  name      String
  email     String
  phone     String?
  type      String   @default("feedback")
  subject   String
  message   String
  status    String   @default("NEW")
  userId    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Review {
  id          String    @id @default(cuid())
  name        String
  location    String
  rating      Int
  comment     String
  commentHi   String?
  isApproved  Boolean   @default(false)
  userId      String?
  user        User?     @relation(fields: [userId], references: [id])
  propertyId  String?
  jobId       String?
  createdAt   DateTime  @default(now())

  @@index([propertyId])
  @@index([jobId])
}

model PromoCode {
  id            String       @id @default(cuid())
  code          String       @unique
  discountType  DiscountType
  discountValue Float
  minAmount     Float?
  maxUses       Int?
  usedCount     Int          @default(0)
  validFrom     DateTime     @default(now())
  validUntil    DateTime
  isActive      Boolean      @default(true)
  createdAt     DateTime     @default(now())
}

enum DiscountType {
  PERCENT
  FLAT
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String
  title     String
  body      String
  isRead    Boolean  @default(false)
  link      String?
  createdAt DateTime @default(now())

  @@index([userId])
}

// NextAuth required models
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model SearchAlert {
  id          String        @id @default(cuid())
  userId      String
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  type        PropertyType?
  purpose     Purpose?
  city        String?
  locality    String?
  maxPrice    Float?
  minBedrooms Int?
  isActive    Boolean       @default(true)
  createdAt   DateTime      @default(now())
}

model Enquiry {
  id          String    @id @default(cuid())
  propertyId  String?
  property    Property? @relation(fields: [propertyId], references: [id], onDelete: SetNull)
  jobId       String?
  job         Job?      @relation(fields: [jobId], references: [id], onDelete: SetNull)
  senderName  String
  senderPhone String
  message     String
  isRead      Boolean   @default(false)
  createdAt   DateTime  @default(now())
}

model Report {
  id         String   @id @default(cuid())
  propertyId String?
  jobId      String?
  reason     String
  details    String?
  createdAt  DateTime @default(now())
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}
